# Django (development defaults; set secure values in production)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
# Production: point to shared Redis and use the trusted reverse-proxy IP header
CACHE_URL=
RATELIMIT_IP_META_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: leave unset for SQLite, or provide a PostgreSQL URL
# DATABASE_URL=postgres://user:password@localhost:5432/plateau_nurse

# Public links
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Expiry reminders
REMINDER_DAYS=30

# NIN encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
NIN_ENCRYPTION_KEY=

# Email
# Gmail SMTP: use a Google App Password (not your regular Gmail password).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=

# Optional admin alerts
SLACK_WEBHOOK_URL=

# Public verification
PUBLIC_VERIFY_RATE=30/m
LICENCE_EXPIRY_WARNING_DAYS=180
CARD_LINK_MAX_AGE=604800
CARD_LINK_SALT=registry.card
RATELIMIT_ENABLE=True
